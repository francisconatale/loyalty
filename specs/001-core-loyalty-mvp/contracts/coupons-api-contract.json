{
  "openapi": "3.0.3",
  "info": {
    "title": "Loyalty Engine — Coupons & Redemptions API",
    "version": "1.0.0",
    "description": "Authenticated contracts for POS coupon validation and redemption at checkout. Protected by X-API-KEY."
  },
  "servers": [
    {
      "url": "/api/v1/coupons"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/validate": {
      "post": {
        "summary": "Validate coupon code at POS checkout",
        "description": "Requires X-API-KEY. Validates code within authenticated tenant scope with rate limiting against brute force.",
        "operationId": "validateCoupon",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateCouponRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CouponValidationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-API-KEY"
          },
          "404": {
            "description": "Coupon not found"
          },
          "429": {
            "description": "Too many failed attempts (rate limit triggered)"
          }
        }
      }
    },
    "/redeem": {
      "post": {
        "summary": "Redeem single-use coupon",
        "description": "Requires X-API-KEY. Idempotently marks the coupon as redeemed for a specific ticket reference.",
        "operationId": "redeemCoupon",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedeemCouponRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Coupon successfully redeemed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedeemCouponResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-API-KEY"
          },
          "409": {
            "description": "Coupon already used, expired, or invalid"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-KEY"
      }
    },
    "schemas": {
      "ValidateCouponRequest": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 64,
            "example": "DESC15-XYZ89"
          }
        }
      },
      "CouponValidationResponse": {
        "type": "object",
        "required": ["code", "status", "isValid", "discountType", "discountValue"],
        "properties": {
          "code": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["AVAILABLE", "REDEEMED", "EXPIRED", "CANCELLED"]
          },
          "isValid": {
            "type": "boolean"
          },
          "discountType": {
            "type": "string",
            "enum": ["PERCENTAGE", "FIXED_AMOUNT"]
          },
          "discountValue": {
            "type": "number",
            "format": "double",
            "example": 15.0
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "RedeemCouponRequest": {
        "type": "object",
        "required": ["code", "transactionReference"],
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 64,
            "example": "DESC15-XYZ89"
          },
          "transactionReference": {
            "type": "string",
            "maxLength": 128,
            "example": "ticket-2026-99"
          }
        }
      },
      "RedeemCouponResponse": {
        "type": "object",
        "required": ["code", "status", "redeemedAt", "transactionReference"],
        "properties": {
          "code": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "example": "REDEEMED"
          },
          "redeemedAt": {
            "type": "string",
            "format": "date-time"
          },
          "transactionReference": {
            "type": "string"
          }
        }
      }
    }
  }
}
