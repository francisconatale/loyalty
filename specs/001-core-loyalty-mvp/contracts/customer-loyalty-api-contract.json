{
  "openapi": "3.0.3",
  "info": {
    "title": "Loyalty Engine — Customer & Loyalty Query API",
    "version": "1.0.0",
    "description": "BFF REST API for customer profiles, point balances, and statement history."
  },
  "servers": [
    {
      "url": "/api/v1/customers"
    }
  ],
  "paths": {
    "/{id}/loyalty": {
      "get": {
        "summary": "Get customer loyalty account balance and tier info",
        "operationId": "getCustomerLoyalty",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Customer loyalty balance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerLoyaltyResponse"
                }
              }
            }
          },
          "404": {
            "description": "Customer or loyalty account not found"
          }
        }
      }
    },
    "/{id}/transactions": {
      "get": {
        "summary": "Get customer immutable point ledger transactions",
        "operationId": "getCustomerTransactions",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Point transaction list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PointTransactionResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CustomerLoyaltyResponse": {
        "type": "object",
        "required": ["customerId", "programName", "pointsBalance", "lifetimePoints"],
        "properties": {
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "programName": {
            "type": "string",
            "example": "Puntos Kioskito"
          },
          "pointsBalance": {
            "type": "integer",
            "format": "int64",
            "example": 350
          },
          "lifetimePoints": {
            "type": "integer",
            "format": "int64",
            "example": 1200
          }
        }
      },
      "PointTransactionResponse": {
        "type": "object",
        "required": ["id", "type", "amount", "description", "createdAt"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": ["EARN", "REDEEM", "EXPIRE", "ADJUST", "REVERSAL"]
          },
          "amount": {
            "type": "integer",
            "format": "int64",
            "example": 250
          },
          "description": {
            "type": "string",
            "example": "Puntos acreditados por compra sale-10023"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
